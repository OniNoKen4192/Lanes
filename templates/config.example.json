{
  "schema_version": 1,
  "project": {
    "app_subdir": "wisconsin-ice-exchange",
    "command_prefix": "cd wisconsin-ice-exchange &&"
  },
  "commands": {
    "test": "pnpm vitest run",
    "lint": "pnpm eslint",
    "typecheck": "pnpm tsc --noEmit",
    "acceptance_runner": "pnpm vitest run"
  },
  "backend": {
    "name": "codex-mcp",
    "dispatch_tool": "mcp__codex__codex",
    "reply_tool": "mcp__codex__codex-reply",
    "approval_mode": "pilot",
    "tiers": [
      "sol",
      "terra",
      "luna"
    ],
    "ratelimit_signal": [
      "usage-cap",
      "429",
      "rate limit"
    ]
  },
  "routing": {
    "security_routed": [
      "wisconsin-ice-exchange/src/auth.ts",
      "wisconsin-ice-exchange/src/lib/authz.ts",
      "wisconsin-ice-exchange/src/lib/availability.ts",
      "wisconsin-ice-exchange/prisma/schema.prisma",
      "wisconsin-ice-exchange/prisma/migrations/**"
    ],
    "do_not_touch": [
      "wisconsin-ice-exchange/src/components/ui/**",
      "wisconsin-ice-exchange/pnpm-lock.yaml",
      "wisconsin-ice-exchange/.env",
      "wisconsin-ice-exchange/.env.example"
    ]
  },
  "review_suite": {
    "suite_command": "pnpm test:ux",
    "id_pattern": "<id>-",
    "id_index": "docs/workflows.md",
    "route_map": {
      "wisconsin-ice-exchange/src/app/admin/**": [
        "a1",
        "a2",
        "a3",
        "a4",
        "a5",
        "a6",
        "a7",
        "a8"
      ],
      "wisconsin-ice-exchange/src/app/org/**": [
        "o1",
        "o2",
        "o3",
        "o4"
      ],
      "wisconsin-ice-exchange/src/app/teams/**": [
        "s5",
        "s6",
        "s7",
        "s10",
        "v2"
      ],
      "wisconsin-ice-exchange/src/app/account/**": [
        "s11"
      ]
    }
  },
  "pipeline": {
    "plans_dir": "docs/superpowers/plans",
    "tasks_dir": "docs/superpowers/tasks",
    "ledger": ".superpowers/sdd/progress.md"
  },
  "automation": {
    "level": "manual",
    "max_fix_rounds": 2
  }
}
